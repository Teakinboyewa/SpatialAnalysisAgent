{
    // Debug the QGIS plugin inside a running QGIS. See dev/README.md for the one-time setup.
    // SpatialAnalysisAgent-master = the plugin's folder name in the QGIS plugins folder (the link name).
    // remoteRoot uses the Windows profile path; on Linux use
    //   "${env:HOME}/.local/share/QGIS/QGIS3/profiles/default/python/plugins/SpatialAnalysisAgent-master"
    // and on macOS
    //   "${env:HOME}/Library/Application Support/QGIS/QGIS3/profiles/default/python/plugins/SpatialAnalysisAgent-master"
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Start QGIS and attach",
            "type": "debugpy",
            "request": "attach",
            "preLaunchTask": "Start QGIS (debug)",
            "connect": { "host": "127.0.0.1", "port": 5678 },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "${env:APPDATA}\\QGIS\\QGIS3\\profiles\\default\\python\\plugins\\SpatialAnalysisAgent-master"
                }
            ],
            "justMyCode": true
        },
        {
            "name": "Attach to QGIS",
            "type": "debugpy",
            "request": "attach",
            "connect": { "host": "127.0.0.1", "port": 5678 },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "${env:APPDATA}\\QGIS\\QGIS3\\profiles\\default\\python\\plugins\\SpatialAnalysisAgent-master"
                }
            ],
            "justMyCode": true
        }
    ]
}
